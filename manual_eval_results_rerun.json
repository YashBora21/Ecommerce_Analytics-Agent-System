    "case": 8,
    "name": "correlation",
    "question": "What's the correlation between review score and delivery days, in plain terms?",
    "status": 200,
    "seconds": 22.46,
    "answer": "The correlation between review score and delivery days is -0.3534, indicating a modest negative relationship: generally, orders that take longer to be delivered tend to receive slightly lower review scores, while faster deliveries are associated with somewhat higher scores.",
    "thread_id": "suite2-correlation",
    "chart": null,
    "evidence": [
      {
        "kind": "sql",
        "sql": "SELECT ROUND((AVG(review_score * delivery_days) - AVG(review_score) * AVG(delivery_days)) / (SQRT(AVG(review_score * review_score) - AVG(review_score) * AVG(review_score)) * SQRT(AVG(delivery_days * delivery_days) - AVG(delivery_days) * AVG(delivery_days))),4) AS correlation FROM orders WHERE review_score BETWEEN 1 AND 5 AND delivery_days >= 0;",
        "result": "correlation\n-0.3534"
      }
    ],
